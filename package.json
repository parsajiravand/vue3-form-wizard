{
  "name": "vue3-form-wizard",
  "private": false,
  "author": "parsa jiravand",
  "version": "1.2.0",
  "description": "vue3-form-wizard is a vue based component with no external depenendcies which simplifies tab wizard management.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parsajiravand/vue3-form-wizard.git"
  },
  "homepage": "https://github.com/parsajiravand/vue3-form-wizard",
  "files": [
    "dist"
  ],
  "main": "./dist/vue3-form-wizard.umd.js",
  "module": "./dist/vue3-form-wizard.es.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue3-form-wizard.es.js",
      "require": "./dist/vue3-form-wizard.umd.js"
    },
    "./dist/style.css": "./dist/vue3-form-wizard.css",
    "./dist/vue3-form-wizard.css": "./dist/vue3-form-wizard.css"
  },
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "./dist/vue3-form-wizard.css"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc  --emitDeclarationOnly",
    "build:source": "mkdirp dist/source && cp -r ./src/**/ ./dist/source/",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "vue",
    "vue3",
    "steppers",
    "vue-stepper",
    "vuejs",
    "form",
    "wizard",
    "tab",
    "nuxt",
    "vue3-form-wizard",
    "vue form wizard",
    "vue3 form wizard",
    "vue3 wizard",
    "vue3 form",
    "nuxt3",
    "nuxt3 form wizard",
    "nuxt3 form",
    "nuxt3 wizard",
    "nuxt3 vue3 form wizard"
  ],
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^25.0.0",
    "@vitejs/plugin-vue-jsx": "^1.3.10",
    "@vue/test-utils": "^2.4.6",
    "@vitest/ui": "^2.1.4",
    "mkdirp": "^1.0.4",
    "sass": "^1.50.1",
    "sass-loader": "10",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-banner": "^0.2.0",
    "vitest": "^2.1.4",
    "vue": "^3.5.22",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.12"
  }
}
